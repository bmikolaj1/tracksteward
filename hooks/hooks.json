{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "& ([WildcardPattern]::Escape(($env:CLAUDE_PLUGIN_ROOT + '/hooks/coord-scope-guard.ps1').Replace([string][char]96, [string][char]96 * 2))); if ($null -eq $LASTEXITCODE) { exit 1 }; exit $LASTEXITCODE"],
            "timeout": 10,
            "statusMessage": "Checking track file scope..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "& ([WildcardPattern]::Escape(($env:CLAUDE_PLUGIN_ROOT + '/hooks/coord-scope-guard.ps1').Replace([string][char]96, [string][char]96 * 2))); if ($null -eq $LASTEXITCODE) { exit 1 }; exit $LASTEXITCODE"],
            "timeout": 10,
            "statusMessage": "Recording session anchor..."
          }
        ]
      }
    ]
  }
}
